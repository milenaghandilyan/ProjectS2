<Window x:Class="StudyPlannerUI2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Study Planner" Height="650" Width="1000"
        Background="#F5F7FA" FontFamily="Segoe UI Semibold"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
<!-- Global Button Style: Defines the blue rounded look and hover effects -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

<!-- Input Field Style: Applied to TextBoxes and PasswordBoxes -->
        <Style x:Key="ModernInput" TargetType="Control">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<!-- Clean DataGrid Style: Removes standard bulky borders -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="AuthPanel" Visibility="Visible" 
                Width="350" VerticalAlignment="Center" HorizontalAlignment="Center" 
                Background="White" Padding="30" CornerRadius="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🎯 Study Planner" FontSize="28" FontWeight="Bold" 
                           Foreground="#2D3436" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <TextBlock Text="Organize your learning journey" Foreground="#636E72" 
                           Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <TextBlock Text="Username" FontSize="12" Foreground="#2D3436"/>
                <TextBox x:Name="TxtUser" Style="{StaticResource ModernInput}"/>

                <TextBlock Text="Password" FontSize="12" Foreground="#2D3436"/>
                <PasswordBox x:Name="TxtPass" Style="{StaticResource ModernInput}"/>

                <Button Content="Login" Click="BtnLogin_Click" Style="{StaticResource ModernButton}" 
                        Background="#4CAF50" Height="40" Margin="0,10,0,5"/>
                <Button Content="Create an account" Click="BtnRegister_Click" 
                        Background="Transparent" Foreground="#4A90E2" BorderThickness="0"/>
            </StackPanel>
        </Border>

<!-- SECTION: Main Dashboard (Visible after login) -->
        <Grid x:Name="MainPlannerPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="LblWelcome" Text="Hello, Student!" FontSize="20" 
                               FontWeight="Bold" Margin="0,0,0,25" Foreground="#2D3436"/>

                    <TextBlock Text="Task Title" FontSize="11" Foreground="#636E72"/>
                    <TextBox x:Name="TxtTitle" Style="{StaticResource ModernInput}"/>

                    <TextBlock Text="Subject" FontSize="11" Foreground="#636E72"/>
                    <TextBox x:Name="TxtSubject" Style="{StaticResource ModernInput}"/>

                    <TextBlock Text="Deadline" FontSize="11" Foreground="#636E72"/>
                    <DatePicker x:Name="DateDeadline" Margin="0,5,0,15" Height="35"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Priority (1-3)" FontSize="11"/>
                            <TextBox x:Name="TxtPriority" Text="1" Style="{StaticResource ModernInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Difficulty (1-3)" FontSize="11"/>
                            <TextBox x:Name="TxtDifficulty" Text="1" Style="{StaticResource ModernInput}"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Add Task" Click="BtnAdd_Click" Style="{StaticResource ModernButton}" Margin="0,10" Height="30"/>

                    <Separator Margin="0,20" Background="#F0F2F5"/>

                    <Button Content="✨ Optimize Schedule" Click="BtnOptimize_Click" 
                            Style="{StaticResource ModernButton}" Background="#6C5CE7" Height="45"/>

                    <Button Content="Sign Out" Click="BtnSignOut_Click" Background="Transparent" 
                            Foreground="#FF7675" Margin="0,40,0,0" Height="30"/>
                </StackPanel>
            </Border>

<!-- Content Area: Task List Display -->
            <Grid Grid.Column="1" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Current Schedule" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2D3436"/>

                <Border Grid.Row="1" CornerRadius="12" Background="White" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>
                    <DataGrid x:Name="TaskGrid" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Task Title" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding Deadline, StringFormat=d}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Done" Binding="{Binding IsCompleted}" Width="60"/>
                            <DataGridTemplateColumn Header="Delete" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Click="BtnDeleteTask_Click" 
                                                Background="#FFEAA7" Foreground="#D63031" Width="30" Height="30" 
                                                Style="{StaticResource ModernButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
